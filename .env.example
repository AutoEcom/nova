# MultiversX Mainnet wallet + payments
# Get a WalletConnect Project ID: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Bech32 treasury that receives EGLD / USDC for $NOVA purchases
NEXT_PUBLIC_TREASURY_ADDRESS=erd1aufyc6j0q9aqda7cev7erad22xm7g0vhupv9rccd5xjgjgcetypqzey2me

# Evolgo staking smart contract (bech32). When unset, staking UI uses mock mode.
# Deploy locally (uses TREASURY_MNEMONIC, no .pem):
#   npm run deploy:staking:dry
#   npm run deploy:staking
NEXT_PUBLIC_STAKING_CONTRACT=

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix with NEXT_PUBLIC_
# Required for automatic $NOVA delivery after a successful payment.
# The wallet must match NEXT_PUBLIC_TREASURY_ADDRESS and hold enough NOVA-04c5f5.
# ---------------------------------------------------------------------------

# Full PEM file contents (use \n for newlines in Vercel env), OR:
TREASURY_WALLET_PEM=

# 12/24-word mnemonic for the same treasury wallet (alternative to PEM)
TREASURY_MNEMONIC=purpose sort coil pond alley enable gorilla panda village miss sunset beauty chronic output once siren method shiver hood scare equip drift pet olympic

# ---------------------------------------------------------------------------
# Referrals + Supabase
# ---------------------------------------------------------------------------
# Public site origin used when building shareable invite links
NEXT_PUBLIC_SITE_URL=https://evolgo.app

# Salt for deterministic invite-code derivation (change in production)
REFERRAL_CODE_SALT=

# Supabase project (referral_codes / attributions / balances)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Optional 32+ char secret for AES-GCM encryption of exchange API keys
# (falls back to hashing SUPABASE_SERVICE_ROLE_KEY if unset)
EXCHANGE_API_ENCRYPTION_KEY=
