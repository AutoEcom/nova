# MultiversX Mainnet wallet + payments
# Get a WalletConnect Project ID: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Bech32 treasury that receives EGLD / USDC for $NOVA purchases
NEXT_PUBLIC_TREASURY_ADDRESS=erd1aufyc6j0q9aqda7cev7erad22xm7g0vhupv9rccd5xjgjgcetypqzey2me

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix with NEXT_PUBLIC_
# Required for automatic $NOVA delivery after a successful payment.
# The wallet must match NEXT_PUBLIC_TREASURY_ADDRESS and hold enough NOVA-04c5f5.
# ---------------------------------------------------------------------------

# Full PEM file contents (use \n for newlines in Vercel env), OR:
TREASURY_WALLET_PEM=

# 12/24-word mnemonic for the same treasury wallet (alternative to PEM)
TREASURY_MNEMONIC=

# ---------------------------------------------------------------------------
# Referrals (optional)
# ---------------------------------------------------------------------------
# Public site origin used when building shareable invite links
NEXT_PUBLIC_SITE_URL=https://evolgo.app

# Salt for deterministic invite-code derivation (change in production)
REFERRAL_CODE_SALT=

# Optional override for the file-backed referral registry directory
# REFERRAL_DATA_DIR=.data
