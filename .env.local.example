# MultiversX Mainnet wallet + payments
# Get a WalletConnect Project ID: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Bech32 treasury that receives EGLD / USDC for $NOVA purchases
NEXT_PUBLIC_TREASURY_ADDRESS=erd1aufyc6j0q9aqda7cev7erad22xm7g0vhupv9rccd5xjgjgcetypqzey2me

# Evolgo staking SC (bech32). Leave empty for local mock staking UI.
# NEXT_PUBLIC_STAKING_CONTRACT=erd1...

# SERVER ONLY — required for automatic $NOVA delivery after payment
# Put real secrets in .env.local (gitignored), NEVER in this example file.
# TREASURY_WALLET_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# TREASURY_MNEMONIC=word1 word2 ... word24

# Referrals + Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# REFERRAL_CODE_SALT=local-dev-salt
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
